generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Task {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    title     String
    status    String
    createdAt DateTime @default(now())
    @@index([createdAt], map: "createAt_index")
}
